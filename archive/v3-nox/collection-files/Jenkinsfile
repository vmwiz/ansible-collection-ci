// Jenkinsfile (declaratif) - test/validation d'une collection Ansible (airgap, Nexus)
// Toute la logique est dans noxfile.py ; Jenkins ne fait qu'orchestrer.
//
// Deux types d'agents :
//   1. Pod Kubernetes sur OpenShift (prefere : Jenkins partage, elasticite). SCC restricted-v2 :
//      UID aleatoire, non-root, pas de socket ni de privileged -> etapes SANS conteneurs
//      (lint, docs, build, galaxy-importer, security-scan, spotter, sanity/units en mode venv).
//      Modele de pod : ci/jenkins-agent-pod.yaml (ou modele global via inheritFrom, cf. infra/openshift).
//   2. VM "ansible-builder" (label) avec podman rootless : etapes AVEC conteneurs
//      (ansible-test --docker via podman, integration, molecule, sanity multi-Python).
//
// Plugins : Pipeline, Kubernetes, JUnit, Credentials Binding, Workspace Cleanup, Timestamper, AnsiColor.
// Credentials : 'nexus-galaxy-hosted-token' (secret text, publication),
//               'spotter-api-token' (secret text, jeton API de l'instance Spotter privee).

def POD_YAML = 'ci/jenkins-agent-pod.yaml'
def VM_LABEL = 'ansible-builder'
// Sur la VM, nox est installe dans un venv dedie (cf. infra/ansible-builder-vm)
def VM_NOX   = '/opt/ansible-ci/bin/nox'

pipeline {
    agent none

    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 3, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds(abortPrevious: true)
    }

    triggers {
        // Execution quotidienne : detecte les regressions dues aux nouvelles versions des outils
        cron(env.BRANCH_NAME == 'main' ? 'H 6 * * *' : '')
    }

    environment {
        PIP_INDEX_URL                 = 'https://nexus.corp.local/repository/pypi-group/simple'
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        ANSIBLE_TEST_IMAGE_MIRROR     = 'nexus.corp.local:8444'
        ANSIBLE_TEST_PYPI_ENDPOINT    = 'https://nexus.corp.local/repository/pypi-group/simple/'
        ANSIBLE_CORE_VERSIONS         = '2.19 2.20 2.21 2.22'
        ANSIBLE_CORE_PRERELEASE       = '2.22'   // release candidate au 20/10/2026 : vider a la GA
        ANSIBLE_CORE_DEFAULT          = '2.21'
        // Instance Steampunk Spotter PRIVEE (jamais le SaaS)
        SPOTTER_ENDPOINT              = 'https://spotter.corp.local/api'
        SPOTTER_CACERT                = '/etc/pki/tls/certs/ca-bundle.crt'
        FORCE_COLOR                   = '1'
    }

    stages {
        // ------------------------------------------------------------------ pod OpenShift
        stage('Statique (pod OpenShift)') {
            agent {
                kubernetes {
                    yamlFile POD_YAML
                    defaultContainer 'runner'
                    retries 2
                }
            }
            stages {
                stage('Lint') {
                    steps {
                        sh 'nox -R -s lint'
                    }
                }
                stage('Docs') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh 'nox -R -s docs'
                        }
                    }
                }
                stage('Build + galaxy-importer') {
                    steps {
                        sh 'nox -R -s build galaxy-importer'
                    }
                }
                stage('Securite : ansible-security-scanner') {
                    steps {
                        // Bloquant : code retour != 0 si constat HIGH/CRITICAL
                        sh 'nox -R -s security-scan'
                    }
                }
                stage('Securite : Steampunk Spotter') {
                    steps {
                        // Non bloquant au demarrage (calibrage des regles), passer en bloquant ensuite
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            withCredentials([string(credentialsId: 'spotter-api-token', variable: 'SPOTTER_TOKEN')]) {
                                sh 'nox -R -s spotter'
                            }
                        }
                    }
                }
            }
            post {
                always {
                    junit testResults: 'reports/security/*.xml, reports/spotter/*.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'dist/*.tar.gz, reports/**', allowEmptyArchive: true
                    stash name: 'dist', includes: 'dist/*.tar.gz', allowEmpty: true
                }
            }
        }

        stage('Tests rapides (pod, ansible-test --venv)') {
            matrix {
                agent {
                    kubernetes {
                        yamlFile POD_YAML
                        defaultContainer 'runner'
                        retries 2
                    }
                }
                axes {
                    axis {
                        name 'ANSIBLE_CORE'
                        values '2.19', '2.20', '2.21', '2.22'
                    }
                    axis {
                        name 'TEST'
                        values 'sanity', 'units'
                    }
                }
                stages {
                    stage('venv') {
                        environment {
                            ANSIBLE_TEST_MODE = 'venv'
                        }
                        steps {
                            sh 'nox -R -s "${TEST}-${ANSIBLE_CORE}"'
                        }
                    }
                }
                post {
                    always {
                        junit testResults: 'reports/**/junit/*.xml', allowEmptyResults: true
                        archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
                    }
                }
            }
        }

        // ------------------------------------------------------------------ VM ansible-builder (podman)
        stage('Tests conteneurs (VM ansible-builder, podman)') {
            matrix {
                agent {
                    label VM_LABEL
                }
                axes {
                    axis {
                        name 'ANSIBLE_CORE'
                        values '2.19', '2.20', '2.21', '2.22'
                    }
                    axis {
                        name 'TEST'
                        values 'sanity', 'units', 'integration'
                    }
                }
                stages {
                    stage('podman') {
                        // sanity/units "pleine fidelite" (toutes les versions Python de l'image) :
                        // branche principale, tags et execution planifiee ; integration : toujours.
                        when {
                            anyOf {
                                environment name: 'TEST', value: 'integration'
                                branch 'main'
                                buildingTag()
                                triggeredBy 'TimerTrigger'
                            }
                        }
                        environment {
                            ANSIBLE_TEST_MODE          = 'docker'
                            ANSIBLE_TEST_PREFER_PODMAN = '1'
                            CONTAINER_ENGINE           = 'podman'
                        }
                        steps {
                            sh "${VM_NOX} -R -s \"\${TEST}-\${ANSIBLE_CORE}\""
                        }
                    }
                }
                post {
                    always {
                        junit testResults: 'reports/**/junit/*.xml', allowEmptyResults: true
                        archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
                    }
                    cleanup {
                        cleanWs()
                    }
                }
            }
        }

        stage('Molecule (VM ansible-builder, podman)') {
            agent {
                label VM_LABEL
            }
            environment {
                CONTAINER_ENGINE = 'podman'
            }
            steps {
                // La session pre-tire les images cibles depuis le Nexus (MOLECULE_IMAGES)
                sh "${VM_NOX} -R -s molecule"
            }
            post {
                cleanup {
                    cleanWs()
                }
            }
        }

        // ------------------------------------------------------------------ publication
        stage('Publish') {
            when {
                buildingTag()
            }
            agent {
                kubernetes {
                    yamlFile POD_YAML
                    defaultContainer 'runner'
                }
            }
            environment {
                GALAXY_PUBLISH_SERVER = 'nexus_hosted'
                ANSIBLE_GALAXY_SERVER_NEXUS_HOSTED_TOKEN = credentials('nexus-galaxy-hosted-token')
            }
            steps {
                unstash 'dist'
                sh 'nox -R -s publish'
            }
        }
    }
}
