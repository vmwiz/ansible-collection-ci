# Red Hat certification reference reproduced by `aci certification` (SINGLE SOURCE of the versions).
# Origin: ansible-collections/partner-certification-checker v6.0.0,
#         .github/workflows/certification-reusable.yml (checked 2026-10-20).
# Update when the checker changes (then cut a minor release of aci / the runner image).
ACI_CERT_CHECKER_VERSION=6.0.0
ACI_CERT_PYTHON=3.12                  # "Downstream Execution Environments use Python 3.12"
ACI_CERT_ANSIBLE_CORE=2.16.19         # build, import and lint
ACI_CERT_GALAXY_IMPORTER=0.4.39       # GALAXY_IMPORTER_VER
ACI_CERT_ANSIBLE_LINT=26.4.0          # ANSIBLE_LINT_VER, run with --profile=production
ACI_CERT_EXTRA_PIP="distlib>=0.3.9"   # installed by the checker for ansible-galaxy build
ACI_CERT_IMPORTER_CHECK_REQUIRED_TAGS=True
ACI_CERT_IMPORTER_RUN_ANSIBLE_LINT=False
# Sanity: stable-X.Y branches, filtered by the lower bound of requires_ansible (same rule as the checker)
ACI_CERT_SANITY_CORES="2.16 2.18 2.20"
ACI_CERT_SANITY_PYTHON=3.12
# Accepted lower bounds of requires_ansible (core supported by AAP 2.6 / 2.7; 2.19 = Technology Preview)
ACI_CERT_SUPPORTED_CORES="2.16 2.18 2.20"
# Guards (partner-certification-requirements docs, ansible-lint "sanity" rule)
ACI_CERT_SANITY_IGNORE_ALLOWED="validate-modules:missing-gplv3-license action-plugin-docs import-2.6 import-2.6!skip import-2.7 import-2.7!skip import-3.5 import-3.5!skip compile-2.6 compile-2.6!skip compile-2.7 compile-2.7!skip compile-3.5 compile-3.5!skip shellcheck shebang pylint:used-before-assignment"
ACI_CERT_LINT_MANDATORY_RULES="risky-shell-pipe command-instead-of-shell meta-no-info package-latest no-handler meta-runtime[unsupported-version] no-changed-when risky-file-permissions command-instead-of-module unnamed-task"
ACI_CERT_LINT_PROTECTED_PATHS="plugins roles extensions"
ACI_CERT_LINT_ALLOWED_EXCLUDES="extensions/molecule"
