# Excerpt of /etc/gitlab-runner/config.toml - runners dedicated to Ansible collections (airgapped).
# Two runners, selected by the job "tags" in .gitlab-ci.yml:
#   tag "ansible-runner"  -> kubernetes executor (restricted pods, no container engine)
#   tag "ansible-builder" -> shell executor on the ansible-builder VM (rootless podman, /opt/ansible-ci/bin/aci)
# (default tags of the runner-tags / builder-tags inputs of the gitlab-ci-templates component)
# On OpenShift the runner can also be deployed with the certified "GitLab Runner" operator
# (same [runners.kubernetes] section in the configuration ConfigMap).

concurrent = 20

# ---------------------------------------------------------------------------------------------
# 1) Kubernetes executor on OpenShift (SCC restricted-v2)
# ---------------------------------------------------------------------------------------------
[[runners]]
  name = "openshift-ansible-collections"
  url = "https://gitlab.corp.local/"
  executor = "kubernetes"
  # token = "..."   (gitlab-runner register / operator)
  [runners.kubernetes]
    namespace = "ci-ansible"
    image = "nexus.corp.local:8443/corp/ci-tools-image:2026.10.2"
    # Helper that supports arbitrary UIDs (GitLab UBI "ocp" images), served by the Nexus proxy
    # of registry.gitlab.com (port 8446) - align the tag with the runner version.
    helper_image = "nexus.corp.local:8446/gitlab-org/ci-cd/gitlab-runner-ubi-images/gitlab-runner-helper-ocp:<runner-version>"
    pull_policy = ["if-not-present"]
    privileged = false
    allow_privilege_escalation = false
    cap_drop = ["ALL"]
    cpu_request = "1"
    memory_request = "2Gi"
    memory_limit = "6Gi"
    # No runAsUser: OpenShift injects a random UID from the namespace range (GID 0).
    [runners.kubernetes.pod_security_context]
      run_as_non_root = true
    # Optional: persistent cache of the aci venvs (otherwise recreated from Nexus in every job, ~30-60 s).
    # RWX PVC (aci locks its venvs with flock); do NOT use the GitLab `cache:` (path inside the project).
    # [[runners.kubernetes.volumes.pvc]]
    #   name = "ansible-ci-cache"
    #   mount_path = "/home/ci/.cache/ansible-ci"

# ---------------------------------------------------------------------------------------------
# 2) Shell executor on the "ansible-builder" VM (rootless podman)
# ---------------------------------------------------------------------------------------------
[[runners]]
  name = "ansible-builder-vm"
  url = "https://gitlab.corp.local/"
  executor = "shell"
  shell = "bash"
  # Jobs run as the service user (gitlab-runner): it needs /etc/subuid + /etc/subgid ranges,
  # "loginctl enable-linger gitlab-runner" and XDG_RUNTIME_DIR, otherwise rootless podman cannot
  # find its runtime directory (no logind session through su).
  environment = ["XDG_RUNTIME_DIR=/run/user/<UID-gitlab-runner>", "ANSIBLE_TEST_PREFER_PODMAN=1", "ACI_CONTAINER_ENGINE=podman"]
  limit = 4
