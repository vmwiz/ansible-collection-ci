# Controleur Jenkins de test : 2.580.1 + plugins pipeline/kubernetes/... (image de base du banc) + git.
ARG JENKINS_IMAGE=localhost/jk:test
FROM ${JENKINS_IMAGE}
RUN jenkins-plugin-cli --plugins git
# Depots de test en file:// (bibliotheque + collection) : autorise explicitement (SECURITY-2478)
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false -Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true"
COPY init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/
COPY jobs/ /usr/share/jenkins/ref/e2e-jobs/
