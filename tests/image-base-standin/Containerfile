# TEST UNIQUEMENT : emule l'image de base d'entreprise "ubi9-corp:9.8" (UBI 9 + python3 systeme 3.9,
# AC interne, /etc/pip.conf vers le proxy PyPI, depots microdnf). Ici les depots restent ceux d'UBI.
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
RUN microdnf -y install --setopt=install_weak_deps=0 --nodocs python3 python3-pip && microdnf clean all
COPY corp-test-ca.crt /etc/pki/ca-trust/source/anchors/corp-test-ca.crt
RUN update-ca-trust
COPY pip.conf /etc/pip.conf
ENV REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt \
    SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
