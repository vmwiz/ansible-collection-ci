# Inbound Jenkins agent (websocket) = ci-tools-image + Java 21: stands in for the OpenShift pod
# (in production: pod from resources/ansible-ci/pod.yaml, jnlp + runner containers; the bench has no cluster).
ARG CI_TOOLS_IMAGE=localhost/corp/ci-tools-image:2026.10
FROM ${CI_TOOLS_IMAGE}
USER 0
RUN microdnf -y install --setopt=install_weak_deps=0 --nodocs java-21-openjdk-headless && microdnf clean all
COPY agent.jar /opt/jenkins/agent.jar
# agent JVM: UTF-8 file names (archiveArtifacts fails on non-ASCII names otherwise)
ENV LANG=C.UTF-8
USER 1001
ENTRYPOINT ["sh", "-c", "exec java -jar /opt/jenkins/agent.jar -url \"$JENKINS_URL\" -secret @\"$JENKINS_SECRET_FILE\" -name \"$JENKINS_AGENT_NAME\" -webSocket -workDir \"$HOME/agent\""]
