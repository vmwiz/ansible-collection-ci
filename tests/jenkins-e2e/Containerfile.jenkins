# Test controller: Jenkins 2.580.1 + the plugins the library needs. The bench setup (global library,
# credentials, agents, jobs: what an admin does in Manage Jenkins) is done by init.groovy.d/ at every start.
ARG JENKINS_IMAGE=docker.io/jenkins/jenkins:2.580.1-jdk21
FROM ${JENKINS_IMAGE}
RUN jenkins-plugin-cli --plugins workflow-aggregator pipeline-model-definition pipeline-groovy-lib git \
      kubernetes credentials-binding plain-credentials junit timestamper ansicolor \
      pipeline-stage-view
# pipeline-stage-view: bench only, its wfapi/describe REST API is used to check the stage order
# Test repositories over file:// (library + collections): explicitly allowed (SECURITY-2478)
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false -Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true"
COPY init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/
